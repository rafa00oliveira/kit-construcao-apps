# Copie para a raiz do projeto (MANUAL-CONSTRUCAO.md, P12). Pede npm 11 recente: `npm config ls -l` mostra a chave.

# Não instala versão publicada há menos de 7 dias: pacote sequestrado costuma ser descoberto nesse prazo.
# Vale no `npm install`; o `npm ci` instala o que o lockfile já tem.
# Correção de segurança urgente fura de propósito: npm install <pacote>@<versão> --min-release-age=0
min-release-age=7

# Dependência indireta não puxa código de git, URL, arquivo ou pasta; só o que o seu package.json declarar.
allow-git=root
# Num app nosso (Next 16 com Tailwind 4) esta linha fez o npm install falhar com EALLOWREMOTE, no pacote
# @tailwindcss/oxide-wasm32-wasi; num projeto limpo com Tailwind 4 não falhou (npm 11.17, 14/11/2026). Se acontecer,
# tire só esta linha e escreva o motivo aqui.
allow-remote=root
allow-file=root
allow-directory=root
